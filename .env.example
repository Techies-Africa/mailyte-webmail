# Where the mail server's API lives. Read at REQUEST time on the server, so it
# can be changed with a restart and needs no rebuild.
MAILBOX_API_BASE_URL="http://localhost:8080/api/v1"

# What this deployment calls itself. Rendered in the browser, so unlike the
# URL above these are baked in at build time.
NEXT_PUBLIC_BRAND_NAME="Webmail"
NEXT_PUBLIC_BRAND_MARK="✉"

# Optional deployment analytics. Read at container runtime, not build time.
GOOGLE_ANALYTICS_ID=
CLARITY_PROJECT_ID=

# Optional Cloudflare Turnstile on sign-in: both keys, or neither. Read at
# runtime. Cloudflare's always-pass test pair, for local work:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
